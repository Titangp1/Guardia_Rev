rules_version = '2';

// Guardia_Rev · règles de sécurité Firestore. Réalisé par Titan_gp1.
//
// Données :
//   users/{uid}         progression privée : pseudo, progress (QCM, cartes, exercices, XP…), updatedAt
//   profiles/{uid}      profil public : pseudo, avatar (photo 192 px en data URL), bio, group, hidden,
//                       xp, level, streak, badges, createdAt, updatedAt
//   challenges/{id}     défi entre deux étudiants : from, fromName, to, toName, sid, qids, fromScore, fromTime,
//                       toScore, toTime, status (pending | done), createdAt, doneAt
//
// Ce que ces règles garantissent :
//   * il faut être connecté avec une adresse @guardiaschool.fr DONT L'EMAIL EST VÉRIFIÉ ;
//   * les adresses bannies n'ont accès à rien ;
//   * la progression privée n'est lisible et modifiable que par son propriétaire ;
//   * les profils sont lisibles par les étudiants connectés (classement), modifiables par leur seul propriétaire ;
//     les XP ne peuvent que monter, de 3000 au plus par écriture (ou revenir à 0) ; la photo est une petite image ;
//   * un défi n'est lisible que par ses deux joueurs ; seul l'adversaire peut y répondre, une seule fois.

service cloud.firestore {
  match /databases/{database}/documents {

    function guardia() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('^[^@]+@guardiaschool[.]fr$')
        && !banned();
    }
    // Adresses bannies : empreintes SHA-256 de l'email en minuscules (alignées sur assets/config.js).
    function banned() {
      return hashing.sha256(request.auth.token.email.lower()).toHexString().lower() in [
        '50fdb7e7463cbc703e96a7e378002137ef56c3effa71e6e6bf295942cc03f6dc',
        '584f24b53e94295bc618fd1941b653bf45866923f5e81357abf194e8668bb1ed',
        'd0f8637156ca71f4d8bb4d4b6582ab58234d2997feceae4843a452f815f5b5b4',
        '817a0deca5e0ca6f5799a9a56584ab8ac88fc666107ddc25e43e55a0165cf72b'
      ];
    }
    function owner(uid) {
      return guardia() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['pseudo', 'progress', 'updatedAt'])
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo.size() <= 24
        && request.resource.data.progress is map
        && request.resource.data.updatedAt == request.time;
    }

    function validProfile(d) {
      return d.keys().hasOnly(['pseudo', 'avatar', 'bio', 'group', 'hidden', 'xp', 'level', 'streak', 'badges', 'createdAt', 'updatedAt'])
        && d.pseudo is string && d.pseudo.size() >= 2 && d.pseudo.size() <= 24
        && d.avatar is string && d.avatar.size() <= 120000
        && (d.avatar == '' || d.avatar.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'))
        && d.bio is string && d.bio.size() <= 80
        && d.group is string && d.group.size() <= 20
        && d.hidden is bool
        && d.xp is int && d.xp >= 0
        && d.level is int && d.level >= 1 && d.level <= 200
        && d.streak is int && d.streak >= 0
        && d.badges is list && d.badges.size() <= 40
        && d.updatedAt == request.time;
    }

    match /profiles/{uid} {
      allow read: if guardia();
      allow create: if owner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.xp <= 10000
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.xp == 0
            || (request.resource.data.xp >= resource.data.xp && request.resource.data.xp - resource.data.xp <= 3000));
      allow delete: if owner(uid);
    }

    match /challenges/{id} {
      allow read: if guardia()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if guardia()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'toName', 'sid', 'qids', 'fromScore', 'fromTime', 'toScore', 'toTime', 'status', 'createdAt', 'doneAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.to))
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 24
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 24
        && request.resource.data.sid is string && request.resource.data.sid.size() <= 20
        && request.resource.data.qids is list && request.resource.data.qids.size() >= 1 && request.resource.data.qids.size() <= 20
        && request.resource.data.fromScore is int && request.resource.data.fromScore >= 0 && request.resource.data.fromScore <= request.resource.data.qids.size()
        && request.resource.data.fromTime is int && request.resource.data.fromTime >= 1
        && request.resource.data.toScore == null && request.resource.data.toTime == null && request.resource.data.doneAt == null
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if guardia()
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['toScore', 'toTime', 'status', 'doneAt'])
        && request.resource.data.status == 'done'
        && request.resource.data.toScore is int && request.resource.data.toScore >= 0 && request.resource.data.toScore <= resource.data.qids.size()
        && request.resource.data.toTime is int && request.resource.data.toTime >= 1
        && request.resource.data.doneAt == request.time;
      allow delete: if guardia()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
