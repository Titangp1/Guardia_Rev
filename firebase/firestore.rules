rules_version = '2';

// Guardia_Rev · règles de sécurité Firestore (durcies).
// Collections :
//   users/{uid}      progression privée (pseudo, progress, updatedAt)
//   profiles/{uid}   profil public (pseudo, avatar, bio, group, hidden, xp, level, streak, badges, createdAt, updatedAt)
//   challenges/{id}  défi 1v1 (from, fromName, to, toName, sid, qids, fromScore, fromTime, toScore, toTime, status, createdAt, doneAt)

service cloud.firestore {
  match /databases/{database}/documents {

    function isGuardiaVerified() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('(?i)^[^@]+@guardiaschool\\.fr$');
    }

    function isOwner(uid) {
      return isGuardiaVerified() && request.auth.uid == uid;
    }

    function validString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // Autorise uniquement une Data URL image raster (PNG/JPEG/WebP) <= 150 Ko (bloque SVG/JS)
    function validAvatar(data) {
      return !('avatar' in data)
        || data.avatar == null
        || data.avatar == ''
        || (
          data.avatar is string
          && data.avatar.size() <= 150000
          && data.avatar.matches('^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$')
        );
    }

    function validMetrics(data) {
      return data.xp is int && data.xp >= 0 && data.xp <= 1000000
        && data.level is int && data.level >= 1 && data.level <= 200
        && data.streak is int && data.streak >= 0 && data.streak <= 3650;
    }

    // Progression privée de l'utilisateur
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && validString(request.resource.data.pseudo, 40)
        && request.resource.data.progress is map;
      allow delete: if isOwner(uid);
    }

    // Profil public (classement et consultation entre étudiants)
    match /profiles/{uid} {
      allow read: if isGuardiaVerified();

      allow create: if isOwner(uid)
        && validString(request.resource.data.pseudo, 40)
        && (!('bio' in request.resource.data) || validString(request.resource.data.bio, 240))
        && (!('group' in request.resource.data) || validString(request.resource.data.group, 30))
        && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool)
        && validAvatar(request.resource.data)
        && validMetrics(request.resource.data)
        && request.resource.data.xp <= 5000;

      allow update: if isOwner(uid)
        && validString(request.resource.data.pseudo, 40)
        && (!('bio' in request.resource.data) || validString(request.resource.data.bio, 240))
        && (!('group' in request.resource.data) || validString(request.resource.data.group, 30))
        && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool)
        && validAvatar(request.resource.data)
        && validMetrics(request.resource.data)
        && request.resource.data.xp >= resource.data.xp
        && (request.resource.data.xp - resource.data.xp) <= 5000;

      allow delete: if isOwner(uid);
    }

    // Défis entre étudiants
    match /challenges/{id} {
      allow read: if isGuardiaVerified();

      allow create: if isGuardiaVerified()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && validString(request.resource.data.fromName, 40)
        && validString(request.resource.data.toName, 40)
        && validString(request.resource.data.sid, 30)
        && request.resource.data.status == 'pending'
        && request.resource.data.qids is list
        && request.resource.data.qids.size() >= 1
        && request.resource.data.qids.size() <= 30
        && request.resource.data.fromScore is int
        && request.resource.data.fromScore >= 0
        && request.resource.data.fromScore <= request.resource.data.qids.size()
        && request.resource.data.fromTime is number
        && request.resource.data.fromTime > 0;

      allow update: if isGuardiaVerified()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'done'
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['toScore', 'toTime', 'status', 'doneAt'])
        && request.resource.data.toScore is int
        && request.resource.data.toScore >= 0
        && request.resource.data.toScore <= resource.data.qids.size()
        && request.resource.data.toTime is number
        && request.resource.data.toTime > 0;

      allow delete: if isGuardiaVerified()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
  }
}
